# Frontend Environment Variables Template
# Copy this file to .env.local for local development, or add these variables to your Vercel Project Settings.

# Backend API & WebSocket Endpoint (e.g., your Oracle Cloud VM IP or Cloudflare Tunnel URL)
NEXT_PUBLIC_API_URL=http://<ORACLE-IP-OR-TUNNEL-DOMAIN>:8080/api
NEXT_PUBLIC_SOCKET_URL=http://<ORACLE-IP-OR-TUNNEL-DOMAIN>:8080

# Stripe Publishable Key (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
