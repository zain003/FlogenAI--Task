# Backend Environment Variables
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/marketplace

# Authentication & Security
# WARNING: JWT_SECRET is mandatory with zero fallback in codebase
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRATION=1d

# Redis Configuration (Used for Socket.IO adapter & distributed locks)
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe Payment & Webhook Configuration
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret
